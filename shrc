export COLUMNS
export HISTSIZE=100000

if test -e /opt/homebrew/bin/brew
  fish_add_path "/opt/homebrew/bin"
end

fish_add_path ~/.local/bin

# Shared agent from a systemd user unit, unless one is already provided (macOS
# launchd, SSH agent forwarding): gcr's on desktops, OpenSSH's otherwise.
if not set -q SSH_AUTH_SOCK
  for ssh_agent_socket in $XDG_RUNTIME_DIR/gcr/ssh $XDG_RUNTIME_DIR/ssh-agent.socket
    if test -S $ssh_agent_socket
      set -gx SSH_AUTH_SOCK $ssh_agent_socket
      break
    end
  end
end

# Lets sudo prompt for a password without a terminal, e.g. from editors and
# agents.
if test -x ~/.local/bin/rofi-askpass
  set -gx SUDO_ASKPASS ~/.local/bin/rofi-askpass
end

source ~/.aliases

mise activate fish | source

starship init fish | source

# Last, so a machine can override anything above
if test -e ~/.config/dotfiles/config.fish
  source ~/.config/dotfiles/config.fish
end
