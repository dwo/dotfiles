export COLUMNS
export HISTSIZE=100000
export GOPATH="$HOME/src"
set PATH $PATH $GOPATH/bin

if test -e /opt/homebrew/bin/brew
  fish_add_path "/opt/homebrew/bin"
end

fish_add_path ~/.local/bin

# Shared agent from systemd's ssh-agent.socket user unit, unless one is
# already provided (macOS launchd, SSH agent forwarding).
set -l ssh_agent_socket $XDG_RUNTIME_DIR/ssh-agent.socket
if not set -q SSH_AUTH_SOCK; and test -S $ssh_agent_socket
  set -gx SSH_AUTH_SOCK $ssh_agent_socket
end

source ~/.aliases

mise activate fish | source

starship init fish | source

# Optional machine-specific shell init
if [ -e ~/.sh_local ]; source ~/.sh_local;
end
