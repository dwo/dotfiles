#!/bin/bash

# Submodules
git submodule init && git submodule update

# System packages
if [ "$(uname)" == "Darwin" ]; then
  if ! [ -x "$(command -v brew)" ]; then
    echo "Please install homebrew."
    exit 1
  fi
  brew bundle --quiet
elif [ -e /etc/os-release ]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  if [ ! -e /usr/bin/ansible-playbook ]; then
    case "$ID" in
      arch)
        sudo pacman -S --needed --noconfirm ansible
        ;;
      ubuntu)
        sudo apt update
        sudo apt install software-properties-common --yes
        sudo add-apt-repository --yes --update ppa:ansible/ansible
        sudo apt install ansible-core --yes
        ;;
    esac
  fi
  ansible-playbook linux.yaml -K -e "user=$(whoami)"
fi

# Shell
cp aliases "$HOME"/.aliases
mkdir -p "$HOME"/.config/fish
cp shrc "$HOME"/.config/fish/config.fish
cp starship.toml "$HOME"/.config/starship.toml

# Ghostty
mkdir -p "$HOME"/.config/ghostty
cp config.ghostty "$HOME"/.config/ghostty/config.ghostty

# GNU Screen
cp screenrc "$HOME"/.screenrc

# Git
cp gitattributes ~/.gitattributes
cp gitignore "$HOME"/.gitignore
GIT_EMAIL=$(git config --global --get user.email)
if [ -z "$GIT_EMAIL" ]; then
  read -r -p "Email for Git (<user>@users.noreply.github.com): " email
  GIT_EMAIL=$email
fi
GIT_SIGNINGKEY=$(git config --global --get user.signingkey)
if [ -z "$GIT_SIGNINGKEY" ]; then
  read -r -p "Signing Key for Git (from ssh-add -L): " signingkey
  GIT_SIGNINGKEY=$signingkey
fi
cp gitconfig.template "$HOME"/.gitconfig
git config --file "$HOME"/.gitconfig user.email "$GIT_EMAIL"
git config --file "$HOME"/.gitconfig user.signingkey "$GIT_SIGNINGKEY"

# Development tools
mkdir -p "$HOME"/.config/mise
cp mise.toml "$HOME"/.config/mise/config.toml
work_env='set -gx MISE_ENV work'
if [ "${MISE_ENV:-}" == work ] || grep -qxF "$work_env" "$HOME"/.sh_local 2>/dev/null; then
  grep -qxF "$work_env" "$HOME"/.sh_local 2>/dev/null || echo "$work_env" >> "$HOME"/.sh_local
  export MISE_ENV=work
  cp mise.work.toml "$HOME"/.config/mise/config.work.toml
  cp terraformrc "$HOME/.terraformrc"
fi
mise install --quiet --yes

# Agent instructions
mkdir -p "$HOME"/.config
cp AGENTS.md "$HOME"/.config/AGENTS.md
mkdir -p "$HOME"/.claude
ln -sfn "$HOME"/.config/AGENTS.md "$HOME"/.claude/CLAUDE.md
mkdir -p "$HOME"/.codex
ln -sfn "$HOME"/.config/AGENTS.md "$HOME"/.codex/AGENTS.md

# Vim
mkdir -p "$HOME"/.vimswap
cp vimrc "$HOME"/.vimrc
mkdir -p "$HOME"/.config/nvim
cp init.vim "$HOME"/.config/nvim/init.vim

#   ...plugins
mkdir -p ~/.vim/pack/plugins/start
repo_root=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)
for plugin in "$HOME"/.vim/pack/plugins/start/*; do
  [ -L "$plugin" ] || continue
  name=$(basename "$plugin")
  case "$(readlink "$plugin")" in
    "$PWD/dotvim/vendor/$name"|"$repo_root/dotvim/vendor/$name"|"$repo_root"/.worktrees/*/dotvim/vendor/"$name")
      if ! git config --file .gitmodules --get "submodule.dotvim/vendor/$name.path" >/dev/null; then
        rm "$plugin"
      fi
      ;;
  esac
done
#   symlink my vendored submodules into the vim packages system
find dotvim/vendor -maxdepth 1 -mindepth 1 -type d | while read -r dir; do
  symlink="$(basename "$dir")"
  git config --file .gitmodules --get "submodule.$dir.path" >/dev/null || continue
  if [ ! -e ~/.vim/pack/plugins/start/"$symlink" ] && [ ! -L ~/.vim/pack/plugins/start/"$symlink" ]; then
    ln -s "$PWD/$dir" ~/.vim/pack/plugins/start/"$symlink"
  fi
done

mkdir -p ~/.vim/ftplugin
find dotvim/ftplugin -maxdepth 1 -mindepth 1 -type f | while read -r ftplugin; do
  cp "$ftplugin" ~/.vim/ftplugin/.
done

echo "Your dotfiles have been copied to $HOME"
